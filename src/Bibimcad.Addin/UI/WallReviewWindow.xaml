<Window x:Class="Bibimcad.UI.WallReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bibimcad - Review wall candidates"
        Width="1100"
        Height="680"
        MinWidth="820"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Layer" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="LayerFilter" Width="200" SelectionChanged="OnFilterChanged" />
            <TextBlock Text="Status" VerticalAlignment="Center" Margin="16,0,6,0" />
            <ComboBox x:Name="StatusFilter" Width="140" SelectionChanged="OnFilterChanged" />
            <TextBlock x:Name="CountsText" VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="Approve selected" Padding="10,4" Click="OnApprove" />
                <Button Content="Reject selected" Padding="10,4" Margin="6,0,0,0" Click="OnReject" />
                <Button Content="Mark unverified" Padding="10,4" Margin="6,0,0,0" Click="OnUnverify" />
                <TextBlock Text="Height (mm)" VerticalAlignment="Center" Margin="16,0,6,0" />
                <TextBox x:Name="HeightInput" Width="70" VerticalContentAlignment="Center" />
                <Button Content="Set height for selected" Padding="10,4" Margin="6,0,0,0" Click="OnSetHeight" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Export CSV..." Padding="10,4" Click="OnExportCsv" />
                <Button Content="Import CSV..." Padding="10,4" Margin="6,0,0,0" Click="OnImportCsv" />
                <Button Content="Save" Padding="18,4" Margin="16,0,0,0" IsDefault="True" Click="OnSave" />
                <Button Content="Cancel" Padding="10,4" Margin="6,0,0,0" IsCancel="True" />
            </StackPanel>
        </DockPanel>

        <TextBlock x:Name="DefaultHeightText" DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="Gray" />

        <DataGrid x:Name="CandidateGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id, Mode=OneWay}" IsReadOnly="True" Width="190" />
                <DataGridTextColumn Header="Layer" Binding="{Binding Layer, Mode=OneWay}" IsReadOnly="True" Width="120" />
                <DataGridTextColumn Header="Length (mm)" Binding="{Binding LengthMm, Mode=OneWay, StringFormat=0.#}" IsReadOnly="True" Width="95" />
                <DataGridTextColumn Header="Thickness (mm)" Binding="{Binding ThicknessMm, Mode=OneWay, StringFormat=0.#}" IsReadOnly="True" Width="105" />
                <DataGridTextColumn Header="Orientation" Binding="{Binding Orientation, Mode=OneWay}" IsReadOnly="True" Width="90" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" IsReadOnly="True" Width="90" />
                <DataGridTextColumn Header="Height (mm)"
                                    Binding="{Binding HeightMm, TargetNullValue='', ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}"
                                    Width="90" />
                <DataGridCheckBoxColumn Header="In Revit" Binding="{Binding HasRevitWall, Mode=OneWay}" IsReadOnly="True" Width="65" />
                <DataGridTextColumn Header="Notes" Binding="{Binding Notes, UpdateSourceTrigger=LostFocus}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>

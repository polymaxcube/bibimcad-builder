<Window x:Class="Bibimcad.UI.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bibimcad - Help"
        Width="780"
        Height="680"
        MinWidth="560"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <DataTemplate x:Key="TopicTemplate">
            <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="3" Margin="0,0,0,6" Padding="8,4" Background="White">
                <Expander IsExpanded="{Binding IsExpanded, Mode=OneTime}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{Binding BadgeBrush}" CornerRadius="2" Padding="6,1" Margin="0,0,8,0" MinWidth="64">
                                <TextBlock Text="{Binding Badge}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="26,6,0,4">
                        <TextBox Text="{Binding Detail, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="What to do:" FontWeight="SemiBold" Margin="0,0,0,2" Visibility="{Binding StepsVisibility}" />
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Number}" FontWeight="SemiBold" />
                                        <TextBox Grid.Column="1" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                                 Background="Transparent" Padding="0" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="12" Background="#F7F7F7">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="Open project__state.json" Padding="10,4" Click="OnOpenState" />
                <Button Content="Open log" Padding="10,4" Margin="6,0,0,0" Click="OnOpenLog" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Close" Padding="18,4" IsCancel="True" IsDefault="True" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,6,0">
                <TextBlock Text="Your project now" FontSize="17" FontWeight="SemiBold" />
                <TextBlock x:Name="SummaryText" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,8" />
                <ItemsControl x:Name="CurrentList" ItemTemplate="{StaticResource TopicTemplate}" />

                <TextBlock Text="Common problems" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,8" />
                <ItemsControl x:Name="CommonList" ItemTemplate="{StaticResource TopicTemplate}" />

                <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="Workflow: 01 Inspect, 02 Coordinates, 03 Read DXF, set wallLayers, 04 Classify, 05 Review, 06 Generate, 07 Validate." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
